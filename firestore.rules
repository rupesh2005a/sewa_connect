rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /customers/{documentId} {
      allow get: if request.auth != null && request.auth.uid == documentId;
      allow list, update, delete: if false;
      allow create: if request.auth != null &&
        request.auth.uid == documentId &&
        request.resource.data.keys().hasOnly([
          'role',
          'fullName',
          'mobileNumber',
          'emailAddress',
          'createdAt'
        ]) &&
        request.resource.data.role == 'customer' &&
        request.resource.data.fullName is string &&
        request.resource.data.fullName.size() >= 2 &&
        request.resource.data.fullName.size() <= 100 &&
        request.resource.data.mobileNumber is string &&
        request.resource.data.mobileNumber.size() >= 8 &&
        request.resource.data.mobileNumber.size() <= 16 &&
        request.resource.data.emailAddress is string &&
        request.resource.data.emailAddress.size() >= 3 &&
        request.resource.data.emailAddress.size() <= 254 &&
        request.resource.data.emailAddress == request.auth.token.email &&
        request.resource.data.createdAt == request.time;
    }

    match /providers/{documentId} {
      allow get: if request.auth != null && request.auth.uid == documentId;
      allow list, update, delete: if false;
      allow create: if request.auth != null &&
        request.auth.uid == documentId &&
        request.resource.data.keys().hasOnly([
          'role',
          'fullName',
          'mobileNumber',
          'emailAddress',
          'vehicleNumber',
          'vehicleType',
          'createdAt'
        ]) &&
        request.resource.data.role == 'provider' &&
        request.resource.data.fullName is string &&
        request.resource.data.fullName.size() >= 2 &&
        request.resource.data.fullName.size() <= 100 &&
        request.resource.data.mobileNumber is string &&
        request.resource.data.mobileNumber.size() >= 8 &&
        request.resource.data.mobileNumber.size() <= 16 &&
        request.resource.data.emailAddress is string &&
        request.resource.data.emailAddress.size() >= 3 &&
        request.resource.data.emailAddress.size() <= 254 &&
        request.resource.data.emailAddress == request.auth.token.email &&
        request.resource.data.vehicleNumber is string &&
        request.resource.data.vehicleNumber.size() >= 4 &&
        request.resource.data.vehicleNumber.size() <= 20 &&
        request.resource.data.vehicleType is string &&
        request.resource.data.vehicleType in ['Car', 'Bike'] &&
        request.resource.data.createdAt == request.time;
    }

    match /bookingRequests/{documentId} {
      allow read, update, delete: if false;
      allow create: if
        request.resource.data.keys().hasOnly([
          'customerName',
          'phoneNumber',
          'service',
          'location',
          'status',
          'createdAt'
        ]) &&
        request.resource.data.customerName is string &&
        request.resource.data.customerName.size() >= 2 &&
        request.resource.data.customerName.size() <= 100 &&
        request.resource.data.phoneNumber is string &&
        request.resource.data.phoneNumber.size() >= 8 &&
        request.resource.data.phoneNumber.size() <= 16 &&
        request.resource.data.service is string &&
        request.resource.data.service.size() > 0 &&
        request.resource.data.location is string &&
        request.resource.data.location.size() >= 2 &&
        request.resource.data.location.size() <= 200 &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdAt == request.time;
    }

    match /transportBookings/{documentId} {
      allow read, update, delete: if false;
      allow create: if
        request.resource.data.keys().hasOnly([
          'service',
          'campus',
          'origin',
          'destination',
          'originLabel',
          'destinationLabel',
          'customerName',
          'routeDistanceKm',
          'selectedVehicleType',
          'perKmRate',
          'estimatedFare',
          'originCoordinates',
          'destinationCoordinates',
          'status',
          'createdAt'
        ]) &&
        request.resource.data.service == 'transport' &&
        request.resource.data.campus == 'Gautam Buddha University, Greater Noida' &&
        request.resource.data.origin is string &&
        request.resource.data.origin.size() >= 2 &&
        request.resource.data.origin.size() <= 300 &&
        request.resource.data.destination is string &&
        request.resource.data.destination.size() >= 2 &&
        request.resource.data.destination.size() <= 300 &&
        request.resource.data.originLabel is string &&
        request.resource.data.originLabel.size() >= 2 &&
        request.resource.data.originLabel.size() <= 300 &&
        request.resource.data.destinationLabel is string &&
        request.resource.data.destinationLabel.size() >= 2 &&
        request.resource.data.destinationLabel.size() <= 300 &&
        request.resource.data.customerName is string &&
        request.resource.data.customerName.size() >= 2 &&
        request.resource.data.customerName.size() <= 100 &&
        request.resource.data.routeDistanceKm is number &&
        request.resource.data.routeDistanceKm > 0 &&
        request.resource.data.selectedVehicleType is string &&
        request.resource.data.selectedVehicleType in ['Bike', 'Car'] &&
        request.resource.data.perKmRate is number &&
        (
          (
            request.resource.data.selectedVehicleType == 'Bike' &&
            request.resource.data.perKmRate == 5
          ) ||
          (
            request.resource.data.selectedVehicleType == 'Car' &&
            request.resource.data.perKmRate == 10
          )
        ) &&
        request.resource.data.estimatedFare is number &&
        request.resource.data.estimatedFare ==
          request.resource.data.routeDistanceKm * request.resource.data.perKmRate &&
        request.resource.data.originCoordinates is map &&
        request.resource.data.originCoordinates.keys().hasOnly(['latitude', 'longitude']) &&
        request.resource.data.originCoordinates.latitude is number &&
        request.resource.data.originCoordinates.longitude is number &&
        request.resource.data.destinationCoordinates is map &&
        request.resource.data.destinationCoordinates.keys().hasOnly(['latitude', 'longitude']) &&
        request.resource.data.destinationCoordinates.latitude is number &&
        request.resource.data.destinationCoordinates.longitude is number &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdAt == request.time;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
