rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isTransportProvider() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/providers/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/providers/$(request.auth.uid)).data.role == 'provider' &&
        get(/databases/$(database)/documents/providers/$(request.auth.uid)).data.services is list &&
        get(/databases/$(database)/documents/providers/$(request.auth.uid)).data.services.hasAny(['Transport']);
    }

    match /customers/{documentId} {
      allow get: if request.auth != null && request.auth.uid == documentId;
      allow list, update, delete: if false;
      allow create: if request.auth != null &&
        request.auth.uid == documentId &&
        request.resource.data.keys().hasOnly([
          'role',
          'fullName',
          'mobileNumber',
          'emailAddress',
          'createdAt'
        ]) &&
        request.resource.data.role == 'customer' &&
        request.resource.data.fullName is string &&
        request.resource.data.fullName.size() >= 2 &&
        request.resource.data.fullName.size() <= 100 &&
        request.resource.data.mobileNumber is string &&
        request.resource.data.mobileNumber.size() >= 8 &&
        request.resource.data.mobileNumber.size() <= 16 &&
        request.resource.data.emailAddress is string &&
        request.resource.data.emailAddress.size() >= 3 &&
        request.resource.data.emailAddress.size() <= 254 &&
        request.resource.data.emailAddress == request.auth.token.email &&
        request.resource.data.createdAt == request.time;
    }

    match /providers/{documentId} {
      allow get: if request.auth != null && request.auth.uid == documentId;
      allow list, delete: if false;
      allow create: if request.auth != null &&
        request.auth.uid == documentId &&
        request.resource.data.keys().hasOnly([
          'role',
          'fullName',
          'mobileNumber',
          'emailAddress',
          'createdAt'
        ]) &&
        request.resource.data.role == 'provider' &&
        request.resource.data.fullName is string &&
        request.resource.data.fullName.size() >= 2 &&
        request.resource.data.fullName.size() <= 100 &&
        request.resource.data.mobileNumber is string &&
        request.resource.data.mobileNumber.size() >= 8 &&
        request.resource.data.mobileNumber.size() <= 16 &&
        request.resource.data.emailAddress is string &&
        request.resource.data.emailAddress.size() >= 3 &&
        request.resource.data.emailAddress.size() <= 254 &&
        request.resource.data.emailAddress == request.auth.token.email &&
        request.resource.data.createdAt == request.time;
      allow update: if request.auth != null &&
        request.auth.uid == documentId &&
        resource.data.role == 'provider' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['services']) &&
        request.resource.data.services is list &&
        request.resource.data.services.size() >= 1 &&
        request.resource.data.services.size() <= 6 &&
        request.resource.data.services.toSet().size() == request.resource.data.services.size() &&
        request.resource.data.services.toSet().difference([
          'Transport',
          'Agriculture & equipment',
          'Repair & maintenance',
          'Home service',
          'Construction',
          'Other local services'
        ].toSet()).size() == 0;
      allow update: if request.auth != null &&
        request.auth.uid == documentId &&
        resource.data.role == 'provider' &&
        resource.data.services is list &&
        resource.data.services.hasAny(['Transport']) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['transportDetails']) &&
        request.resource.data.transportDetails is map &&
        request.resource.data.transportDetails.keys().hasOnly([
          'service',
          'serviceArea',
          'vehicleType',
          'vehicleRegistrationNumber',
          'dateOfBirth',
          'drivingLicenceNumber'
        ]) &&
        request.resource.data.transportDetails['service'] == 'Transport' &&
        request.resource.data.transportDetails.serviceArea == 'Gautam Buddha University, Greater Noida' &&
        request.resource.data.transportDetails.vehicleType in ['Car', 'Bike'] &&
        request.resource.data.transportDetails.vehicleRegistrationNumber is string &&
        (
          request.resource.data.transportDetails.vehicleRegistrationNumber.matches('^[A-Z]{2}[0-9]{1,2}[A-Z]{0,3}[0-9]{1,4}$') ||
          request.resource.data.transportDetails.vehicleRegistrationNumber.matches('^[0-9]{2}BH[0-9]{4}[A-Z]{1,2}$')
        ) &&
        request.resource.data.transportDetails.dateOfBirth is timestamp &&
        request.resource.data.transportDetails.dateOfBirth.year() >= 1900 &&
        (
          request.resource.data.transportDetails.dateOfBirth.year() < request.time.year() - 18 ||
          (
            request.resource.data.transportDetails.dateOfBirth.year() == request.time.year() - 18 &&
            (
              request.resource.data.transportDetails.dateOfBirth.month() < request.time.month() ||
              (
                request.resource.data.transportDetails.dateOfBirth.month() == request.time.month() &&
                request.resource.data.transportDetails.dateOfBirth.day() <= request.time.day()
              )
            )
          )
        ) &&
        request.resource.data.transportDetails.drivingLicenceNumber is string &&
        request.resource.data.transportDetails.drivingLicenceNumber.matches('^[A-Z]{2}[0-9]{2}[A-Z0-9]{6,16}$');
      allow update: if request.auth != null &&
        request.auth.uid == documentId &&
        resource.data.role == 'provider' &&
        resource.data.services is list &&
        resource.data.services.hasAny(['Transport']) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['availability']) &&
        request.resource.data.availability is map &&
        request.resource.data.availability.keys().hasOnly(['status', 'updatedAt']) &&
        request.resource.data.availability.keys().hasAll(['status', 'updatedAt']) &&
        request.resource.data.availability.status == 'unavailable' &&
        request.resource.data.availability.updatedAt == request.time;
    }

    match /providerAvailability/{documentId} {
      function isProviderOwner() {
        return request.auth != null &&
          request.auth.uid == documentId &&
          get(/databases/$(database)/documents/providers/$(documentId)).data.role == 'provider' &&
          get(/databases/$(database)/documents/providers/$(documentId)).data.services.hasAny(['Transport']);
      }

      function isCustomerWithLiveRecord() {
        return request.auth != null &&
          get(/databases/$(database)/documents/customers/$(request.auth.uid)).data.role == 'customer' &&
          resource.data.keys().hasOnly([
            'status',
            'serviceArea',
            'coordinates',
            'vehicleType',
            'updatedAt',
            'expiresAt'
          ]) &&
          resource.data.keys().hasAll([
            'status',
            'serviceArea',
            'coordinates',
            'vehicleType',
            'updatedAt',
            'expiresAt'
          ]) &&
          resource.data.status == 'available' &&
          resource.data.serviceArea == 'Gautam Buddha University, Greater Noida' &&
          resource.data.vehicleType in ['Bike', 'Car'] &&
          resource.data.coordinates is map &&
          resource.data.coordinates.keys().hasOnly(['latitude', 'longitude']) &&
          resource.data.coordinates.latitude is number &&
          resource.data.coordinates.longitude is number &&
          resource.data.updatedAt is timestamp &&
          resource.data.expiresAt is timestamp &&
          resource.data.expiresAt > request.time;
      }

      allow get: if isProviderOwner() || isCustomerWithLiveRecord();
      allow list: if isCustomerWithLiveRecord();
      allow create, update: if isProviderOwner() &&
        request.resource.data.keys().hasOnly(['status', 'updatedAt']) &&
        request.resource.data.keys().hasAll(['status', 'updatedAt']) &&
        request.resource.data.status == 'unavailable' &&
        request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /bookingRequests/{documentId} {
      allow read, update, delete: if false;
      allow create: if
        request.resource.data.keys().hasOnly([
          'customerName',
          'phoneNumber',
          'service',
          'location',
          'status',
          'createdAt'
        ]) &&
        request.resource.data.customerName is string &&
        request.resource.data.customerName.size() >= 2 &&
        request.resource.data.customerName.size() <= 100 &&
        request.resource.data.phoneNumber is string &&
        request.resource.data.phoneNumber.size() >= 8 &&
        request.resource.data.phoneNumber.size() <= 16 &&
        request.resource.data['service'] is string &&
        request.resource.data['service'].size() > 0 &&
        request.resource.data.location is string &&
        request.resource.data.location.size() >= 2 &&
        request.resource.data.location.size() <= 200 &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdAt == request.time;
    }

    match /transportBookings/{documentId} {
      allow get: if request.auth != null &&
        (
          resource.data.customerUid == request.auth.uid ||
          (isTransportProvider() && resource.data.status == 'pending')
        );
      allow list: if isTransportProvider() && resource.data.status == 'pending';
      allow update, delete: if false;
      allow create: if request.auth != null &&
        request.resource.data.customerUid == request.auth.uid &&
        get(/databases/$(database)/documents/customers/$(request.auth.uid)).data.role == 'customer' &&
        request.resource.data.keys().hasOnly([
          'service',
          'campus',
          'customerUid',
          'customerEmailAddress',
          'customerMobileNumber',
          'origin',
          'destination',
          'originLabel',
          'destinationLabel',
          'customerName',
          'routeDistanceKm',
          'selectedVehicleType',
          'perKmRate',
          'estimatedFare',
          'originCoordinates',
          'destinationCoordinates',
          'status',
          'createdAt'
        ]) &&
        request.resource.data['service'] == 'transport' &&
        request.resource.data.campus == 'Gautam Buddha University, Greater Noida' &&
        request.resource.data.customerEmailAddress == request.auth.token.email &&
        request.resource.data.customerEmailAddress == get(/databases/$(database)/documents/customers/$(request.auth.uid)).data.emailAddress &&
        request.resource.data.customerMobileNumber == get(/databases/$(database)/documents/customers/$(request.auth.uid)).data.mobileNumber &&
        request.resource.data.customerName == get(/databases/$(database)/documents/customers/$(request.auth.uid)).data.fullName &&
        request.resource.data.origin is string &&
        request.resource.data.origin.size() >= 2 &&
        request.resource.data.origin.size() <= 300 &&
        request.resource.data.destination is string &&
        request.resource.data.destination.size() >= 2 &&
        request.resource.data.destination.size() <= 300 &&
        request.resource.data.originLabel is string &&
        request.resource.data.originLabel.size() >= 2 &&
        request.resource.data.originLabel.size() <= 300 &&
        request.resource.data.destinationLabel is string &&
        request.resource.data.destinationLabel.size() >= 2 &&
        request.resource.data.destinationLabel.size() <= 300 &&
        request.resource.data.customerName is string &&
        request.resource.data.customerName.size() >= 2 &&
        request.resource.data.customerName.size() <= 100 &&
        request.resource.data.routeDistanceKm is number &&
        request.resource.data.routeDistanceKm > 0 &&
        request.resource.data.selectedVehicleType is string &&
        request.resource.data.selectedVehicleType in ['Bike', 'Car'] &&
        request.resource.data.perKmRate is number &&
        (
          (
            request.resource.data.selectedVehicleType == 'Bike' &&
            request.resource.data.perKmRate == 5
          ) ||
          (
            request.resource.data.selectedVehicleType == 'Car' &&
            request.resource.data.perKmRate == 10
          )
        ) &&
        request.resource.data.estimatedFare is number &&
        request.resource.data.estimatedFare ==
          request.resource.data.routeDistanceKm * request.resource.data.perKmRate &&
        request.resource.data.originCoordinates is map &&
        request.resource.data.originCoordinates.keys().hasOnly(['latitude', 'longitude']) &&
        request.resource.data.originCoordinates.latitude is number &&
        request.resource.data.originCoordinates.latitude >= -90 &&
        request.resource.data.originCoordinates.latitude <= 90 &&
        request.resource.data.originCoordinates.longitude is number &&
        request.resource.data.originCoordinates.longitude >= -180 &&
        request.resource.data.originCoordinates.longitude <= 180 &&
        request.resource.data.destinationCoordinates is map &&
        request.resource.data.destinationCoordinates.keys().hasOnly(['latitude', 'longitude']) &&
        request.resource.data.destinationCoordinates.latitude is number &&
        request.resource.data.destinationCoordinates.latitude >= -90 &&
        request.resource.data.destinationCoordinates.latitude <= 90 &&
        request.resource.data.destinationCoordinates.longitude is number &&
        request.resource.data.destinationCoordinates.longitude >= -180 &&
        request.resource.data.destinationCoordinates.longitude <= 180 &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdAt == request.time;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
